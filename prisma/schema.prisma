generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["aiverse_jobs"]
}

enum ProviderStatus {
  ACTIVE
  PAUSED
  DISABLED

  @@schema("aiverse_jobs")
}

enum JobStatus {
  ACTIVE
  EXPIRED
  REMOVED
  PAUSED

  @@schema("aiverse_jobs")
}

enum IngestionRunStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL

  @@schema("aiverse_jobs")
}

enum OutboxEventType {
  JOB_CREATED
  JOB_UPDATED
  JOB_EXPIRED
  COMPANY_UPDATED

  @@schema("aiverse_jobs")
}

model Provider {
  id                   String         @id @default(cuid())
  name                 String
  type                 String         @unique
  status               ProviderStatus @default(ACTIVE)
  configuration        Json?
  lastSuccessfulSyncAt DateTime?
  lastAttemptedSyncAt  DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  sources              JobSource[]
  ingestionRuns        IngestionRun[]

  @@index([status])
  @@schema("aiverse_jobs")
}

model Company {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  slug           String   @unique
  domain         String?
  website        String?
  logoUrl        String?
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  jobs           Job[]

  @@index([normalizedName])
  @@index([domain])
  @@schema("aiverse_jobs")
}

model SeoPage {
  id                 String   @id @default(cuid())
  type               String
  slug               String
  title              String
  description        String   @db.Text
  keywords           String[] @default([])
  canonicalUrl       String?
  ogTitle            String?
  ogDescription      String?  @db.Text
  ogImage            String?
  ogType             String   @default("website")
  twitterTitle       String?
  twitterDescription String?  @db.Text
  twitterCard        String   @default("summary_large_image")
  alternates         Json?
  jsonLd             Json?
  breadcrumb         Json?
  robotsIndex        Boolean  @default(true)
  robotsFollow       Boolean  @default(true)
  robotsArchive      Boolean  @default(true)
  robotsImageIndex   Boolean  @default(true)
  seoVersion         Int      @default(1)
  seoGeneratedAt     DateTime?
  seoGeneratedBy     String?
  seoScore           Int?
  qualityScore       Int?
  needsReview        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([type, slug])
  @@index([type])
  @@schema("aiverse_jobs")
}

model Job {
  id                 String        @id @default(cuid())
  companyId          String
  title              String
  slug               String        @unique
  description        String?       @db.Text
  descriptionText    String?       @db.Text
  employmentType     String?
  workplaceType      String?
  salaryMin          Float?
  salaryMax          Float?
  salaryCurrency     String?
  salaryPeriod       String?
  postedAt           DateTime?
  firstSeenAt        DateTime      @default(now())
  lastSeenAt         DateTime      @default(now())
  expiresAt          DateTime?
  status             JobStatus     @default(ACTIVE)
  contentHash        String
  dedupeFingerprint  String
  missingSyncCount   Int           @default(0)
  searchVector       Unsupported("tsvector")?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sources            JobSource[]
  locations          JobLocation[]
  skills             JobSkill[]

  @@index([companyId])
  @@index([status])
  @@index([dedupeFingerprint])
  @@index([contentHash])
  @@index([postedAt])
  @@schema("aiverse_jobs")
}

model JobSource {
  id                 String   @id @default(cuid())
  jobId              String
  providerId         String
  sourceJobId        String
  sourceUrl          String
  canonicalSourceUrl String
  applyUrl           String
  rawPayloadLocation String?
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  job                Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider           Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, sourceJobId])
  @@index([jobId])
  @@index([canonicalSourceUrl])
  @@schema("aiverse_jobs")
}

model JobLocation {
  id          String   @id @default(cuid())
  jobId       String
  city        String?
  state       String?
  country     String?
  countryCode String?
  latitude    Float?
  longitude   Float?
  isRemote    Boolean  @default(false)
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([countryCode])
  @@index([city])
  @@index([isRemote])
  @@schema("aiverse_jobs")
}

model Skill {
  id             String     @id @default(cuid())
  name           String
  normalizedName String     @unique
  jobs           JobSkill[]

  @@index([normalizedName])
  @@schema("aiverse_jobs")
}

model JobSkill {
  jobId   String
  skillId String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@schema("aiverse_jobs")
}

model IngestionRun {
  id          String             @id @default(cuid())
  providerId  String
  status      IngestionRunStatus @default(RUNNING)
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  jobsFetched Int                @default(0)
  jobsCreated Int                @default(0)
  jobsUpdated Int                @default(0)
  jobsSkipped Int                @default(0)
  jobsExpired Int                @default(0)
  jobsFailed  Int                @default(0)
  errorMessage String?           @db.Text
  provider    Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  errors      IngestionError[]

  @@index([providerId])
  @@index([status])
  @@index([startedAt])
  @@schema("aiverse_jobs")
}

model IngestionError {
  id             String       @id @default(cuid())
  ingestionRunId String
  provider       String
  sourceJobId    String?
  errorType      String
  errorMessage   String       @db.Text
  payloadLocation String?
  createdAt      DateTime     @default(now())
  ingestionRun   IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)

  @@index([ingestionRunId])
  @@index([provider])
  @@index([createdAt])
  @@schema("aiverse_jobs")
}

model OutboxEvent {
  id            String          @id @default(cuid())
  eventType     OutboxEventType
  aggregateType String
  aggregateId   String
  payload       Json
  processedAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([processedAt])
  @@index([eventType])
  @@index([createdAt])
  @@schema("aiverse_jobs")
}

model Prompt {
  id                String             @id @default(cuid())
  slug              String             @unique
  title             String
  description       String             @db.Text
  prompt            String             @db.Text
  promptType        String
  difficulty        String
  authorName        String?
  sourceUrl         String?
  license           String?
  supportedModels   String[]
  variables         Json?
  exampleInput      Json?
  exampleOutput     String?            @db.Text
  seoTitle          String?
  seoDescription    String?            @db.Text
  seoKeywords       String[]           @default([])
  canonicalUrl      String?
  ogImage           String?
  qualityScore      Int                @default(0)
  readabilityScore  Int                @default(0)
  structureScore    Int                @default(0)
  variablesScore    Int                @default(0)
  reusabilityScore  Int                @default(0)
  status            String             @default("PUBLISHED")
  featured          Boolean            @default(false)
  trendingScore     Float              @default(0)
  publishedAt       DateTime           @default(now())
  lastUpdatedAt     DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  versions          PromptVersion[]
  categories        PromptCategory[]
  tags              PromptTag[]
  sources           PromptSource[]
  embeddings        PromptEmbedding[]
  stats             PromptStat?
  events            PromptEvent[]
  favorites         PromptFavorite[]
  collections       PromptCollectionPrompt[]

  @@index([status])
  @@index([featured])
  @@index([promptType])
  @@index([difficulty])
  @@index([trendingScore])
  @@index([qualityScore])
  @@index([publishedAt])
  @@schema("aiverse_jobs")
}

model PromptVersion {
  id        String   @id @default(cuid())
  promptId  String
  version   Int
  prompt    String   @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  promptRef Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@index([promptId])
  @@schema("aiverse_jobs")
}

model PromptCategory {
  id       String   @id @default(cuid())
  promptId String
  name     String
  slug     String
  prompt   Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, slug])
  @@index([slug])
  @@schema("aiverse_jobs")
}

model PromptTag {
  id       String @id @default(cuid())
  promptId String
  name     String
  slug     String
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, slug])
  @@index([slug])
  @@schema("aiverse_jobs")
}

model PromptSource {
  id          String   @id @default(cuid())
  promptId    String
  sourceType  String
  sourceName  String
  sourceUrl   String?
  contentHash String
  fetchedAt   DateTime @default(now())
  prompt      Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([sourceType])
  @@index([contentHash])
  @@schema("aiverse_jobs")
}

model PromptEmbedding {
  id        String   @id @default(cuid())
  promptId  String
  provider  String
  model     String
  vector    Json
  createdAt DateTime @default(now())
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([provider, model])
  @@schema("aiverse_jobs")
}

model PromptStat {
  promptId      String   @id
  views         Int      @default(0)
  copies        Int      @default(0)
  saves         Int      @default(0)
  likes         Int      @default(0)
  shares        Int      @default(0)
  reports       Int      @default(0)
  weeklyGrowth  Float    @default(0)
  lastViewedAt  DateTime?
  updatedAt     DateTime @updatedAt
  prompt        Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([copies])
  @@index([saves])
  @@index([views])
  @@index([weeklyGrowth])
  @@schema("aiverse_jobs")
}

model PromptEvent {
  id             String   @id @default(cuid())
  promptId       String
  eventType      String
  visitorKey     String?
  idempotencyKey String
  createdAt      DateTime @default(now())
  prompt         Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, eventType, idempotencyKey])
  @@index([promptId])
  @@index([eventType])
  @@index([visitorKey])
  @@index([createdAt])
  @@schema("aiverse_jobs")
}

model PromptFavorite {
  id        String   @id @default(cuid())
  promptId  String
  userKey   String
  createdAt DateTime @default(now())
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, userKey])
  @@index([userKey])
  @@schema("aiverse_jobs")
}

model PromptCollection {
  id          String                   @id @default(cuid())
  slug        String                   @unique
  title       String
  description String?                  @db.Text
  ownerKey    String?
  public      Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  prompts     PromptCollectionPrompt[]

  @@index([public])
  @@index([ownerKey])
  @@schema("aiverse_jobs")
}

model PromptCollectionPrompt {
  collectionId String
  promptId     String
  position     Int      @default(0)
  addedAt      DateTime @default(now())
  collection   PromptCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  prompt       Prompt           @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@id([collectionId, promptId])
  @@index([promptId])
  @@schema("aiverse_jobs")
}

model PromptCrawlLog {
  id             String   @id @default(cuid())
  sourceType     String
  sourceUrl      String
  status         String
  promptsFound   Int      @default(0)
  promptsSaved   Int      @default(0)
  errorMessage   String?  @db.Text
  startedAt      DateTime @default(now())
  completedAt    DateTime?

  @@index([sourceType])
  @@index([status])
  @@index([startedAt])
  @@schema("aiverse_jobs")
}
