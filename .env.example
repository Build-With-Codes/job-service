NODE_ENV=development
PORT=3002
DATABASE_URL=postgresql://postgres:123456@localhost:5432/postgres?schema=aiverse_jobs
DIRECT_URL=postgresql://postgres:123456@localhost:5432/postgres?schema=aiverse_jobs
REDIS_URL=redis://localhost:6379
ADMIN_API_KEY=change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DB_POOL_MAX=10
LOG_LEVEL=info
GREENHOUSE_BOARD_TOKEN=stripe
GREENHOUSE_COMPANY_NAME=Stripe
GREENHOUSE_BASE_URL=https://boards-api.greenhouse.io/v1/boards
ARBEITNOW_BASE_URL=https://www.arbeitnow.com/api/job-board-api
ARBEITNOW_PAGES=3
LEVER_BASE_URL=https://api.lever.co/v0/postings
ASHBY_BASE_URL=https://api.ashbyhq.com/posting-api/job-board
PROVIDER_SYNC_CRON=*/3 * * * *
PROVIDER_SYNC_TYPES=greenhouse,arbeitnow
JOB_EXPIRATION_CRON=0 * * * *
OUTBOX_CRON=* * * * *
AI_JOB_FILTER_ENABLED=true
